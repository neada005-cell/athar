{
  "name": "athar",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "WALL", "class_name": "Wall" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["Wall"] }]
}
